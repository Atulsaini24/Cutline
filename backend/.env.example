# Copy this file to .env (same folder) and fill in what you want. EVERYTHING IS OPTIONAL and FREE.
# With an empty .env the app still works: built-in edit planner + speech segments.
# Restart the server after editing. Never commit .env to GitHub.

# ---------------------------------------------------------------------------------------------
# 1. Edit agent (the AI that plans edits from your instruction). Pick ONE. All have free options.
# ---------------------------------------------------------------------------------------------
# Google Gemini (recommended): free key in 1 minute at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Groq: free key at https://console.groq.com/keys. One Groq key also turns on transcription (below).
GROQ_API_KEY=

# OpenRouter: models ending in ":free" cost nothing. https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Ollama: 100% offline, no account. Install https://ollama.com, run `ollama pull qwen2.5:7b`, then:
# OLLAMA_MODEL=qwen2.5:7b
# OLLAMA_URL=http://localhost:11434

# Advanced (optional):
# LLM_PROVIDER=gemini            # force one: gemini | groq | openrouter | ollama | custom | none
# LLM_MODEL=gemini-2.5-flash     # override the default model of the chosen provider
# LLM_BASE_URL=                  # for "custom": any OpenAI-compatible server (LM Studio, llama.cpp, vLLM)
# LLM_API_KEY=
# LLM_CONTEXT_WORDS=             # how many transcript words to send (defaults depend on the provider)

# ---------------------------------------------------------------------------------------------
# 2. Transcription (word-level timings power filler removal, retakes and captions)
# ---------------------------------------------------------------------------------------------
# If GROQ_API_KEY is set above, Groq's free Whisper large-v3-turbo is used automatically.
# With no key, Whisper runs locally inside the server (no account). It's installed by
# `npm install`; the model (~80 MB) downloads on first use. To pick the local model:
# WHISPER_LOCAL_MODEL=Xenova/whisper-base     # whisper-tiny = faster, whisper-small = more accurate
# WHISPER_LANGUAGE=en                         # e.g. en, hi, es. Empty = auto-detect
# STT_PROVIDER=local                          # force one: groq | local | custom | none
# STT_BASE_URL= / STT_API_KEY= / STT_MODEL=   # for "custom": any OpenAI-compatible /audio/transcriptions

# ---------------------------------------------------------------------------------------------
# 3. Server
# ---------------------------------------------------------------------------------------------
PORT=8787
# Required in production (32+ random characters). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
STORAGE_DIR=./storage
# Postgres instead of SQLite (e.g. a free Neon database). Leave empty for SQLite (zero setup).
DATABASE_URL=
OPENAI_API_KEY=
RENDER_WORKERS=3
JOB_CONCURRENCY=2
RENDER_TTL_DAYS=7
MAX_UPLOAD_GB=20
CORS_ORIGIN=http://localhost:5173
# Public address when deployed (used for review links and OpenRouter attribution)
PUBLIC_URL=
